# ------------------------------------------------------------------
# BeatForge environment
# Copy to .env.local and fill in. Everything is optional in demo mode.
# ------------------------------------------------------------------

# Base URL of the deployed site (used in email / WhatsApp deep links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# WhatsApp delivery (booking orders → producer's phone)
# ------------------------------------------------------------------
#
# DEMO MODE (default): with the two tokens left empty, every WhatsApp
# message is written to the local .whatsapp/ outbox (like .mailbox/ for
# email) and logged to the console. The whole flow works end-to-end.
#
# LIVE MODE: connect the producer's WhatsApp Business number to the
# Meta WhatsApp Business Platform and set:
#
#   WHATSAPP_ACCESS_TOKEN    - permanent token from your Meta app (System user token)
#   WHATSAPP_PHONE_NUMBER_ID - id of the registered sender number
#   WHATSAPP_PRODUCER_NUMBER - the producer's own number (receives booking alerts),
#                              international format without "+", e.g. 233241234567
#   NEXT_PUBLIC_WHATSAPP_NUMBER - number shown on public "Chat on WhatsApp" buttons
#
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PRODUCER_NUMBER=2332400000000
NEXT_PUBLIC_WHATSAPP_NUMBER=2332400000000
